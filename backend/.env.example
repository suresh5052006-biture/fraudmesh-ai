# FraudMesh AI Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (for automated forensic summaries)
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./fraudmesh.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/fraudmesh

# Environment (development / production)
ENVIRONMENT=development

# Authentication enforcement (enforced automatically when ENVIRONMENT=production)
REQUIRE_AUTH=false

# Master Admin Key (grants full platform access)
FRAUDMESH_MASTER_KEY=fm_live_master_secret_2026

# Universal Demo Merchant Key (for showcase and frontend UI)
FRAUDMESH_DEMO_KEY=fm_live_merchant_demo_key_2026

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Device Fingerprint Anonymization Salt (Secret in production)
DEVICE_SALT=fraudmesh_zk_production_secret_salt_2026
