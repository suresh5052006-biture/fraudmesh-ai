# FraudMesh AI - Frontend Environment Variables
# Copy to .env.local to customize local development

# Base URL pointing to the FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api

# Merchant Gateway API Key for authenticated requests
VITE_MERCHANT_API_KEY=fm_live_merchant_demo_key_2026

# Optional: Force mock mode ('true' or 'false'). If omitted, auto-detects based on /api/health
VITE_USE_MOCK=false
